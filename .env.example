ONEBOT_URL=http://napcat:3000
ONEBOT_TOKEN=replace-with-your-napcat-http-token
BRIDGE_TOKEN=replace-with-a-random-64-character-token
EVENT_TOKEN=replace-with-a-different-random-64-character-token
ALLOWED_PEER_ID=123456789
BOT_USER_ID=987654321

DATA_DIR=/data
PUBLIC_BASE_URL=https://napcat-api.example.com
BRIDGE_USER_AGENT=GrokBot-NapCat-Bridge/1.0
BRIDGE_PORT=18080

NAPCAT_NETWORK=napcat_default
NAPCAT_NETWORK_EXTERNAL=true

# Optional Cloudflare named tunnel profile.
CLOUDFLARED_TOKEN=

# Optional: configure Grok through the environment instead of /grok/config.
# GROK_WEBHOOK_URL=
# GROK_WEBHOOK_KEY=
GROK_ALLOWED_HOSTS=api2.cursor.sh
GROK_TIMEOUT_SECONDS=30
ONEBOT_TIMEOUT_SECONDS=15

ENABLE_GROK_WORKER=true
ENABLE_API_DOCS=false
MAX_MESSAGE_LENGTH=1000
RETENTION_DAYS=7
